# Smart redraw (see docs/SMART-REDRAW.md). Off by default in production builds.
# NEXT_PUBLIC_SMART_REDRAW=1
# NEXT_PUBLIC_SMART_REDRAW_URL=http://127.0.0.1:8765

# The names live in lib/brand.ts. Only the addresses come from the environment (see docs/BRAND.md).
# NEXT_PUBLIC_SITE_URL=https://vera.isnaevy.com
# NEXT_PUBLIC_STUDIO_URL=https://isnaevy.com

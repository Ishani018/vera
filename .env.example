# Copy to .env.local (never commit that file) and fill in. All optional: with none
# of these set the app runs open, on your own computer, exactly as before.

# --- Google sign-in -------------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). See docs/DEPLOY-AUTH.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. At least 32 random characters. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET=

# The public address of the app, with no trailing slash. This is what you register
# with Google as <APP_URL>/api/auth/callback. Needed in production.
APP_URL=http://localhost:3000

# Ask everybody to sign in before using the app. Leave unset to keep it open.
# If true but sign-in is not configured, nobody gets in (it fails closed).
AUTH_REQUIRED=false

# Optional. Only these people may sign in: full addresses, or @domain for a whole
# domain. Comma separated. Leave empty to let any Google account in.
AUTH_ALLOWED=
